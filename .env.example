# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/woontegra_license?schema=public

# Server
PORT=4000

# Admin (used by seed)
ADMIN_EMAIL=admin@woontegra.com
ADMIN_PASSWORD=change-me-strong-password

# SUPER_ADMIN e-postaları (virgülle). Boşsa demo test sıfırlaması kapalıdır.
SUPER_ADMIN_EMAILS=

# JWT
JWT_SECRET=change-me-jwt-secret-min-32-chars

# SMTP (optional - mail fails gracefully if not configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@woontegra.com

# Website integration
INTEGRATION_SECRET=change-me-integration-secret

# SaaS provisioning (API key DB'de tutulmaz; targetService=MUVEKKIL_KASA için)
# SAAS_PROVIDER_MUVEKKIL_KASA_URL=https://muvekkil.woontegra.com
# SAAS_PROVIDER_MUVEKKIL_KASA_API_KEY=

# Müvekkil Kasa Desktop lisans mailindeki kurulum bağlantıları (License.platform'a göre biri gösterilir).
# Yalnız public downloads/ yolundaki imzalı kurulum dosyası; updates/ yolu, updater ZIP / latest.yml kullanılmaz.
MUVEKKIL_KASA_WINDOWS_DOWNLOAD_URL=https://download.woontegra.com/downloads/muvekkil-kasa/windows/Woontegra-Muvekkil-Kasa-Defteri-Setup-0.1.14.exe
MUVEKKIL_KASA_MACOS_DOWNLOAD_URL=https://download.woontegra.com/downloads/muvekkil-kasa/macos/Woontegra-Muvekkil-Kasa-Defteri-0.1.16-mac-arm64.dmg
